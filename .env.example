# Public URL of the deployed site (used for canonical URLs, sitemap and OpenGraph).
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub username whose public repositories feed the portfolio.
GITHUB_USERNAME=mrrobot-1001

# Optional, server-only. Raises the API rate limit and enables the live
# contribution calendar. Never prefix with NEXT_PUBLIC_.
# A fine-grained token with no extra scopes (public data only) is enough.
GITHUB_TOKEN=
